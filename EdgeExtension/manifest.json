{
  "manifest_version": 3,
  "name": "ListenFlow 网页听读",
  "description": "使用本机 ListenFlow 和 Windows SAPI 离线朗读网页正文。",
  "version": "0.2.2",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vendor/Readability.js",
        "snapshot-core.js",
        "dom-snapshot.js",
        "highlighter.js",
        "content-script.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "ListenFlow 网页听读"
  }
}
