<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ListenFlow</AssemblyName>
    <RootNamespace>ListenFlow</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ListenFlow.Tests\**\*.cs" />
    <Compile Remove="ListenFlow.Protocol\**\*.cs" />
    <Compile Remove="ListenFlow.NativeHost\**\*.cs" />
    <Compile Remove="ListenFlow.CommunicationProbe\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ListenFlow.Protocol\ListenFlow.Protocol.csproj" />
  </ItemGroup>
</Project>
